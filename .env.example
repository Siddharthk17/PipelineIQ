# PipelineIQ Environment Configuration

# Application
APP_NAME=PipelineIQ
APP_VERSION=12.8.4
DEBUG=false
LOG_LEVEL=INFO

# Database
# Compose values below. For backend-only local dev (no Compose), the code
# defaults to postgresql://postgres:pipelineiq_dev_password@localhost:5432/pipelineiq
# with read/write URLs derived from it (backend/config.py, M-070).
DATABASE_URL=postgresql://pipelineiq:your_password@pgbouncer:5432/pipelineiq
DATABASE_WRITE_URL=postgresql://pipelineiq:your_password@pgbouncer:5432/pipelineiq
DATABASE_READ_URL=postgresql://pipelineiq:your_password@pgbouncer-replica:5432/pipelineiq
POSTGRES_USER=pipelineiq
POSTGRES_PASSWORD=your_password
POSTGRES_DB=pipelineiq
DB_CONNECT_TIMEOUT_SECONDS=5
REPLICATION_USER=replicator
REPLICATION_PASSWORD=your_replication_password
# Signing key for JWTs and cookies. Generate with: openssl rand -hex 32.
# Rotation is a MANUAL owner action (M-122): set the new value in .env,
# GitHub Actions secrets (SECRET_KEY), k8s pipelineiq-secrets, and Render
# env vars, then restart/redeploy all replicas at once (mixed keys
# invalidate each other's tokens). Never commit a real value here.
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
# The y-websocket relay authenticates with the same key: compose maps
# JWT_SECRET=${SECRET_KEY} and k8s maps JWT_SECRET from the SECRET_KEY
# secret entry (M-148). Keep them identical or relay auth breaks.

# Redis & Celery
REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16
REDIS_BROKER_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/0
REDIS_BACKEND_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/1
REDIS_PUBSUB_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-pubsub:6380/0
REDIS_CACHE_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-cache:6381/0
REDIS_YJS_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-yjs:6382/0
# Browser-reachable Yjs relay URL, baked into the frontend at build time.
# Leave empty (default) when the app is served through Nginx, which proxies
# /yjs/ to the relay. Set only for split deployments (e.g. Vercel frontend
# talking directly to ws://host:1234).
#NEXT_PUBLIC_YJS_URL=
CELERY_BROKER_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/1
CELERY_WORKERS_CRITICAL=2
CELERY_WORKERS_DEFAULT=3
CELERY_WORKERS_BULK=2
# Per-task execution limits in seconds (M-094; defaults mirror
# backend/celery_config.py task_soft_time_limit/task_time_limit).
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_HARD_TIME_LIMIT=360

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000
# O2-005: accepted upload suffixes (default .csv,.json,.parquet,.xlsx).
# JSON spelling (same convention as CORS_ORIGINS below).
#ALLOWED_EXTENSIONS=[".csv",".json",".parquet",".xlsx"]
# Default bucket for uploads when the app runs outside Compose. Compose sets
# S3_BUCKET=pipelineiq-uploads explicitly; the backend default
# ("pipelineiq-outputs") is for pipeline OUTPUTS — keep them distinct so a
# bucket lifecycle rule never deletes raw uploads.
# Worker scan guard (M-114): rows scanned per execution; scans beyond this
# raise instead of silently sampling. Tune with available memory.
WORKER_MAX_ROWS_TO_SCAN=10000000
# local = plain filesystem (zero setup, default when unset); s3 = MinIO/S3.
# Startup validation (backend/config.py, M-188): any other value aborts boot,
# and s3 with missing S3_ACCESS_KEY/S3_SECRET_KEY/S3_BUCKET/S3_ENDPOINT_URL
# aborts boot in production (warns elsewhere). Dev default is local via
# backend/config.py; this example file selects s3 because Compose ships MinIO.
STORAGE_TYPE=s3
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=pipelineiq-uploads
# Browser-reachable S3 endpoint used ONLY for signing presigned URLs.
# Leave empty to use S3_ENDPOINT_URL (correct when it is already public).
# Local dev needs the host address, e.g. http://127.0.0.1:9000, because
# browsers cannot resolve the internal docker hostname (minio:9000).
#S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ENDPOINT_URL=http://minio:9000

# Pipeline Execution
MAX_PIPELINE_STEPS=50
MAX_ROWS_PER_FILE=1000000

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost"]
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api,frontend,nginx,host.docker.internal,pipelineiq-api.onrender.com,pipeline-iq0.vercel.app

# Caching

# Rate Limiting
RATE_LIMIT_PIPELINE_RUN=10/minute
RATE_LIMIT_FILE_UPLOAD=30/minute
RATE_LIMIT_VALIDATION=60/minute
RATE_LIMIT_READ=120/minute
# M-047: extra trusted proxy CIDRs for X-Real-IP (comma-separated).
# Loopback + RFC1918/private peers are trusted by default (covers nginx).
#TRUSTED_PROXY_CIDRS=203.0.113.0/24,198.51.100.7

# Schema Drift

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16

# Sentry (optional — leave empty to disable)
# Production error tracking with stack traces. Set this to enable Sentry in
# the API and all Celery workers (init is guarded: empty value = disabled).
# Get a DSN at https://sentry.io (free tier is fine), then:
#   1. put SENTRY_DSN=https://... in .env
#   2. docker compose up -d --force-recreate api worker-critical worker-default worker-bulk worker-gemini worker-streaming celery-beat sse-service
SENTRY_DSN=

# Email (SMTP) — shared by app notifications and Grafana alert mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
# Set true to let Grafana send alert emails via the SMTP settings above.
SMTP_ENABLED=false

# Deployment
ENVIRONMENT=development
# Pinned to match docker-compose default (M-133); override only to a tested tag.
MINIO_IMAGE_TAG=RELEASE.2024-12-13T22-19-12Z

# Public hostname or IP of this deployment (no scheme, no trailing slash).
# Used for the Grafana root URL and trusted-host checks. Auto-detected and
# written by scripts/bootstrap.sh (GCP metadata -> host IPv4 -> localhost).
PUBLIC_HOST=localhost

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Worker / execution limits
WORKER_MEMORY_LIMIT_GB=2
# Master switch for autonomous healing (backend/config.py AUTONOMOUS_HEALING_ENABLED).
AUTONOMOUS_HEALING_ENABLED=true
AUTONOMOUS_HEALING_MAX_ATTEMPTS=3

# Additional config variables
AUTO_CREATE_TABLES=false
PROFILE_MAX_ROWS=1000000
PROFILE_SAMPLE_ROWS=100000
WASM_BUCKET=pipelineiq-wasm

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SAMPLE_RATE=0.1
# Service name reported in traces (backend/config.py OTEL_SERVICE_NAME).
OTEL_SERVICE_NAME=pipelineiq-api
# Jaeger UI base URL used for trace links.
JAEGER_UI_URL=http://localhost:16686
