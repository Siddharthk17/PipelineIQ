# PipelineIQ Environment Configuration

# Application
APP_NAME=PipelineIQ
APP_VERSION=12.8.4
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://pipelineiq:your_password@pgbouncer:5432/pipelineiq
DATABASE_WRITE_URL=postgresql://pipelineiq:your_password@pgbouncer:5432/pipelineiq
DATABASE_READ_URL=postgresql://pipelineiq:your_password@pgbouncer-replica:5432/pipelineiq
POSTGRES_USER=pipelineiq
POSTGRES_PASSWORD=your_password
POSTGRES_DB=pipelineiq
DB_CONNECT_TIMEOUT_SECONDS=5
REPLICATION_USER=replicator
REPLICATION_PASSWORD=your_replication_password
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Redis & Celery
REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16
REDIS_BROKER_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/0
REDIS_BACKEND_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/1
REDIS_PUBSUB_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-pubsub:6380/0
REDIS_CACHE_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-cache:6381/0
REDIS_YJS_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-yjs:6382/0
# Browser-reachable Yjs relay URL, baked into the frontend at build time.
# Leave empty (default) when the app is served through Nginx, which proxies
# /yjs/ to the relay. Set only for split deployments (e.g. Vercel frontend
# talking directly to ws://host:1234).
#NEXT_PUBLIC_YJS_URL=
CELERY_BROKER_URL=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_OPENSSL_RAND_HEX_16@redis-broker:6379/1
CELERY_WORKERS_CRITICAL=2
CELERY_WORKERS_DEFAULT=3
CELERY_WORKERS_BULK=2

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000
STORAGE_TYPE=s3
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=pipelineiq-uploads
# Browser-reachable S3 endpoint used ONLY for signing presigned URLs.
# Leave empty to use S3_ENDPOINT_URL (correct when it is already public).
# Local dev needs the host address, e.g. http://127.0.0.1:9000, because
# browsers cannot resolve the internal docker hostname (minio:9000).
#S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ENDPOINT_URL=http://minio:9000

# Pipeline Execution
MAX_PIPELINE_STEPS=50
MAX_ROWS_PER_FILE=1000000

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost"]
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api,frontend,nginx,host.docker.internal,pipelineiq-api.onrender.com,pipeline-iq0.vercel.app

# Caching

# Rate Limiting
RATE_LIMIT_PIPELINE_RUN=10/minute
RATE_LIMIT_FILE_UPLOAD=30/minute
RATE_LIMIT_VALIDATION=60/minute
RATE_LIMIT_READ=120/minute

# Schema Drift

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16

# Sentry (optional — leave empty to disable)
# Production error tracking with stack traces. Set this to enable Sentry in
# the API and all Celery workers (init is guarded: empty value = disabled).
# Get a DSN at https://sentry.io (free tier is fine), then:
#   1. put SENTRY_DSN=https://... in .env
#   2. docker compose up -d --force-recreate api worker-critical worker-default worker-bulk worker-gemini worker-streaming celery-beat sse-service
SENTRY_DSN=

# Email (SMTP) — shared by app notifications and Grafana alert mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
# Set true to let Grafana send alert emails via the SMTP settings above.
SMTP_ENABLED=false

# Deployment
ENVIRONMENT=development
MINIO_IMAGE_TAG=latest

# Public hostname or IP of this deployment (no scheme, no trailing slash).
# Used for the Grafana root URL and trusted-host checks. Auto-detected and
# written by scripts/bootstrap.sh (GCP metadata -> host IPv4 -> localhost).
PUBLIC_HOST=localhost

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Worker / execution limits
WORKER_MEMORY_LIMIT_GB=2
AUTONOMOUS_HEALING_MAX_ATTEMPTS=3

# Additional config variables
AUTO_CREATE_TABLES=false
PROFILE_MAX_ROWS=1000000
PROFILE_SAMPLE_ROWS=100000
WASM_BUCKET=pipelineiq-wasm

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SAMPLE_RATE=0.1
